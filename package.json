{
  "name": "flow-batch-automator",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.2 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @flow-batch/protocol build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @flow-batch/protocol build && pnpm -r --if-present test && node --test scripts/test/*.test.mjs",
    "test:docker": "node scripts/validate-docker.mjs",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser.mjs",
    "test:browser:flow": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser.mjs --flow-only",
    "test:browser:reuse": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser.mjs --reuse-only",
    "test:browser:formats": "node scripts/validate-browser-formats.mjs",
    "test:browser:queue": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser.mjs --queue-only",
    "test:browser:navigation": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser-navigation.mjs",
    "test:browser:cloning": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser-cloning.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm format:check",
    "dev": "pnpm --filter @flow-batch/protocol build && node scripts/dev.mjs",
    "start": "node packages/orchestrator/dist/main.js",
    "orders": "node scripts/orders.mjs",
    "test:browser:orders": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser.mjs --orders-only",
    "mcp": "node packages/orchestrator/dist/mcp/main.js",
    "library": "node scripts/library.mjs",
    "test:browser:library": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser-library.mjs",
    "mcp:install": "node packages/orchestrator/dist/public/flow-batch-mcp.mjs --install",
    "package:local": "pnpm package:npm",
    "test:package": "node scripts/validate-local-package.mjs",
    "package:npm": "pnpm build && node scripts/package-local.mjs",
    "audit:npm": "node scripts/audit-npm.mjs",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
