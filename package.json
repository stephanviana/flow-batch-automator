{
  "name": "flow-batch-automator",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.2 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @flow-batch/protocol build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @flow-batch/protocol build && pnpm -r --if-present test",
    "test:docker": "node scripts/validate-docker.mjs",
    "test:browser:cloning": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser-cloning.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm format:check",
    "dev": "pnpm --filter @flow-batch/protocol build && node scripts/dev.mjs",
    "orders": "node scripts/orders.mjs",
    "test:browser:orders-design": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser-orders-design.mjs",
    "test:browser:connect": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser-connect.mjs",
    "test:browser:session": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser-session.mjs",
    "mcp": "node packages/orchestrator/dist/mcp/main.js",
    "flow:mcp": "node packages/flow-mcp/dist/main.js",
    "flow:login": "node packages/flow-mcp/dist/main.js --login",
    "flow:connect": "node packages/flow-mcp/dist/main.js --connect",
    "flow:status": "node packages/flow-mcp/dist/main.js --status",
    "flow:pair": "node packages/flow-mcp/dist/main.js --pair",
    "flow:worker": "node packages/flow-mcp/dist/main.js --worker",
    "flow:executor-status": "node packages/flow-mcp/dist/main.js --executor-status",
    "flow:pause": "node packages/flow-mcp/dist/main.js --pause",
    "test:browser:flow-mcp": "node scripts/validate-browser-flow-mcp.mjs",
    "library": "node scripts/library.mjs",
    "test:browser:library": "PLAYWRIGHT_BROWSERS_PATH=.cache/browsers node scripts/validate-browser-library.mjs",
    "mcp:install": "node packages/orchestrator/dist/public/flow-batch-mcp.mjs --install",
    "desktop:dev": "pnpm --filter @flow-batch/desktop dev",
    "desktop:dev:win": "pnpm --filter @flow-batch/desktop dev:win",
    "desktop:dist:win": "pnpm --filter @flow-batch/desktop dist:win"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
