# Compose interpolation only. The app does not automatically read .env on the host.
# Replace SEU_USUARIO and choose an existing local extension directory.
WIN_EXTENSION_DIR=/mnt/c/Users/SEU_USUARIO/flow-batch-extension
LOG_LEVEL=info
# Local instruction package, created or imported before starting Compose.
FLOW_LIBRARY_DIR=/absolute/path/to/Minha-Biblioteca-Flow
