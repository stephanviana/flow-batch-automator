{
  "name": "@flow-batch/protocol",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.cache/test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test .cache/test/test/*.test.js"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
