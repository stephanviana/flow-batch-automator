{
  "name": "@flow-batch/orchestrator",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node copy-public.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node copy-public.mjs .cache/test/src && node --test .cache/test/test/*.test.js",
    "dev": "node ../../scripts/dev.mjs"
  },
  "dependencies": {
    "@flow-batch/protocol": "workspace:*",
    "ws": "8.22.0",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
