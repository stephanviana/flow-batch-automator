{
  "manifest_version": 3,
  "name": "Flow Batch",
  "version": "0.3.1",
  "minimum_chrome_version": "120",
  "description": "Fila local e leitura do projeto no Google Flow pelo painel lateral.",
  "permissions": ["storage", "alarms", "sidePanel", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://flow.google.com/*",
    "https://labs.google/fx/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Flow Batch"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4319 ws://127.0.0.1:4319"
  }
}
